#!/usr/sbin/nft -f

table inet clab
delete table inet clab

table inet clab {
    chain forward {
        type filter hook forward priority 0; policy accept;
        iifname "gw-upstream" accept
        oifname "gw-upstream" ct state related,established accept
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
        ip saddr 10.0.99.0/30 oifname != "gw-upstream" masquerade
    }
}
